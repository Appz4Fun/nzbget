            },
            "lower_vs_one": {
              "enum": [
                "uniform_exact_process_product",
                "directed_decimal_enclosure",
                "exact_rational_root_quantile",
                "exact_radical_quotient_classes"
              ]
            },
            "upper_vs_one": {
              "enum": [
                "uniform_exact_process_product",
                "directed_decimal_enclosure",
                "exact_rational_root_quantile",
                "exact_radical_quotient_classes"
              ]
            },
            "width_vs_policy": {
              "enum": [
                "uniform_exact_process_product",
                "directed_decimal_enclosure",
                "exact_rational_root_quantile",
                "exact_radical_quotient_classes"
              ]
            }
          }
        },
        "quantile_ranks": {
          "const": {
            "lower": [
              [
                124,
                1,
                40
              ],
              [
                125,
                39,
                40
              ]
            ],
            "upper": [
              [
                4874,
                39,
                40
              ],
              [
                4875,
                1,
                40
              ]
            ]
          }
        },
        "width_policy_rational": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2467,
              "pattern": "^[1-9][0-9]*$"
            },
            "denominator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2467,
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower",
            "upper",
            "estimate"
          ],
          "properties": {
            "lower": {
              "$ref": "#/$defs/certificate_interval"
            },
            "upper": {
              "$ref": "#/$defs/certificate_interval"
            },
            "estimate": {
              "$ref": "#/$defs/certificate_interval"
            }
          }
        },
        "bounding_contributors": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/certificate_contributors"
            }
          ]
        },
        "rank_enclosures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "uniform",
            "selected"
          ],
          "properties": {
            "route": {
              "enum": [
                "uniform_exact_process_product",
                "log_endpoint_order_statistics"
              ]
            },
            "uniform": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/certificate_rank_enclosure"
                }
              ]
            },
            "selected": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/certificate_rank_enclosures"
                }
              ]
            }
          },
          "allOf": [
